{
  "name": "pi-self-learn",
  "version": "0.1.0",
  "type": "module",
  "description": "Self-learning memory for the pi coding agent — distills every session into scored, auto-injected lessons (short- and long-term memory, local RAG), 100% on-device",
  "main": "index.ts",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "extension",
    "self-learning",
    "lessons",
    "memory",
    "long-term-memory",
    "session",
    "recall",
    "rag",
    "local-first"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/driderr/pi-session-recall.git"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "files": [
    "index.ts",
    "summarizer.ts",
    "discoverer.ts",
    "config.ts",
    "embeddings.ts",
    "rowstore.ts",
    "logger.ts",
    "types.ts",
    "vcc/",
    "config.example.yaml",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "yaml": "^2.7.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "sync": "node scripts/sync.cjs"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "memfs": "^4.57.6",
    "typescript": "^6.0.3",
    "vitest": "^3.0.0"
  }
}
